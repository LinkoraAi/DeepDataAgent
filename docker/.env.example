# ===========================================================
# DeepDataAgent - docker compose 环境变量模板
#
# 用法：compose up 前先将本文件复制为同目录 .env（docker/.env），
#       并为下列每个变量填入【随机高熵】值。缺失任一变量时
#       compose 会直接报错拒绝启动（fail-fast，不再回落内置默认值）。
#
# 生成建议（随机 32 字节以上，URL-safe Base64）：
#   PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 } | ForEach-Object { [byte]$_ }))
#   Linux/macOS: openssl rand -base64 48
#
# 注意：密钥一经使用不可更换（更换后存量密文 / token 无法解出），请妥善保管。
#
# 部署校验项（AgentScope 2.0.3 升级）：数据库账号（SPRING_DATASOURCE_USERNAME）
# 须具备目标库的 CREATE SCHEMA / CREATE TABLE / ALTER TABLE 权限——框架在应用
# 启动期自建 agentscope schema、agentscope_sessions / agentscope_snapshots 表，
# 并对 agentscope_sessions 幂等补齐 version 列（ADD COLUMN IF NOT EXISTS）；
# 权限不足会在启动阶段 fail-fast，而非运行期报错。
# ===========================================================

# 模型凭证加密密钥（AES/GCM，SHA-256 单轮派生，须 ≥32 字节高熵随机值）
APP_MODEL_ENCRYPTION_KEY=

# 凭证库（vault）加密密钥（AES/GCM，独立于模型 / 数据源密钥，须 ≥32 字节高熵随机值）
APP_VAULT_ENCRYPTION_KEY=

# JWT HS256 签名密钥（须 ≥32 字节高熵随机值）
AUTH_JWT_SECRET=

# -----------------------------------------------------------
# 运行态开关（非密钥，可留空取默认值）
# -----------------------------------------------------------

# 协调租约存储：唯一实现为 Redis（move-coordination-leases-to-redis PR-C4：
# key 前缀 runtime:turn: / runtime:turn-owners: / runtime:fire:；原 PG 表 CAS 实现与
# lease-store 二选一开关已下线，回滚只能整版本回退）。
# 依赖：Redis 侧 appendonly yes + appendfsync everysec、maxmemory-policy noeviction
# （compose 编排已内置）；多实例部署显式配置稳定 APP_INSTANCE_ID。

# turn 租约续约承载形态（move-coordination-leases-to-redis D5③ 容量预案）：
# scheduler=平台线程定时池（默认）；virtual-thread=每轮一个 daemon 虚拟线程 sleep 循环
# （并发轮次上量、续约池排队逼近 10min TTL 时切换）。
# APP_COORDINATION_LEASE_RENEWAL=scheduler

# 实例标识（多实例 / 滚动部署必填稳定值：决定启动恢复只回收本实例槽位残留租约；
# 缺失时回落 HOSTNAME / COMPUTERNAME，再缺失回落随机值并启动 WARN）
# APP_INSTANCE_ID=

# -----------------------------------------------------------
# 对象存储（file 内容 + skill 资产统一承载；非密钥，可留空）
# -----------------------------------------------------------
# 后端类型：local=本地磁盘布局（默认，仅单机 / 开发）；rustfs/minio/oss=S3 兼容共享后端。
# 多实例部署 MUST 选用 S3 系（local 依赖实例本地磁盘，不支持跨实例共享）。
# APP_STORAGE_TYPE=local
# 固定配置桶（S3 系使用；首启自动创建）
# APP_STORAGE_BUCKET=deepdataagent
# 本地布局根目录（仅 type=local 生效，容器内路径；默认 ./data/objects）
# APP_STORAGE_LOCAL_ROOT=./data/objects
# 以下仅 type=rustfs/minio/oss 必填（local 留空）
# APP_STORAGE_ENDPOINT=http://host.docker.internal:9010
# APP_STORAGE_ACCESS_KEY=
# APP_STORAGE_SECRET_KEY=
# APP_STORAGE_REGION=us-east-1
# 路径寻址：RustFS 强制 true；MinIO/OSS 随部署形态
# APP_STORAGE_PATH_STYLE=true

# -----------------------------------------------------------
# 出网信任边界（validate 探测 / OAuth 刷新 / MCP 建连共用同一判定；非密钥，可留空）
# -----------------------------------------------------------
# 内网白名单开关：默认 false = 拒绝回环、本机通配、链路本地（含云元数据 169.254.169.254）、
# 组播、RFC1918 私网与 host.docker.internal 目标（SSRF 防护）；内网自建 MCP / 数据源场景显式置 true。
# APP_EGRESS_ALLOW_PRIVATE_NETWORK=false
# 重定向最大跳数（逐跳复检，超出即失败）
# APP_EGRESS_MAX_REDIRECTS=5

# -----------------------------------------------------------
# 凭证库 MCP OAuth 流转（vault BC；非密钥，可留空取默认值）
# -----------------------------------------------------------
# 回调地址：由服务端配置且【请求不可覆盖】——生产必须改为对外可达地址（授权服务器回调落到此处；
# 前端随后按响应的 callback_origin 校验同源并 postMessage）。须为绝对 http(s) 地址，否则启动即失败。
# APP_VAULT_OAUTH_CALLBACK_URL=http://localhost:8080/api/v1/cloud/vaults/oauth/callback
# 一次性 state 存活时长（秒；默认 300）。Redis 键 vault:oauth-state:<state> 由服务端 TTL 自过期，
# 过期 / 重放 / 跨 owner 一律拒绝（不产生凭证）。
# APP_VAULT_OAUTH_STATE_TTL_SECONDS=300
# access token 刷新窗口（秒；默认 60）：距 expires_at 小于该值才判定「临期」并触发刷新，
# 未临期零出网零写入。
# APP_VAULT_OAUTH_REFRESH_WINDOW_SECONDS=60
# 动态客户端注册上报的客户端展示名（默认 DeepDataAgent）
# APP_VAULT_OAUTH_CLIENT_NAME=DeepDataAgent

# -----------------------------------------------------------
# 凭证库加密信封的密钥版本（说明项，无对应环境变量）
# -----------------------------------------------------------
# 存量列 key_version 仅【预留多版本读取能力】（design Non-Goals：不引入外部 KMS），
# 当前恒为 1；信封形态为 {"kind":"vault_credential_material","version":1,...}，
# 旧形态裸串按「只有访问令牌、无刷新配置」承接读取（存量行无需数据迁移）。
# APP_VAULT_ENCRYPTION_KEY 一经使用不可更换（更换后存量密文无法解出），轮换须配套密钥版本读取路径。

