<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.linkroa</groupId>
        <artifactId>core</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>core-backend</artifactId>
    <name>DeepDataAgent Backend</name>
    <description>Spring Boot backend for DeepDataAgent.</description>

    <properties>
        <!-- surefire 排除组默认值（align-qoder-vault-credential-capabilities tasks 2.7 选项 a）：
             默认 test 档排除 @Tag("integration") 用例（依赖真实 PostgreSQL / Redis / Docker）；
             CI 集成任务以 -Dsurefire.excludedGroups= 置空放行该组，并须提供 TEST_PG_URL /
             TEST_REDIS_URL（缺失即快速失败）。 -->
        <surefire.excludedGroups>integration</surefire.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Redisson 核心库（协调租约 Redis 存储，move-coordination-leases-to-redis D1）：
             手动装配 RedissonClient + RScript EVALSHA 执行 owner-scoped Lua；
             不引 spring-boot-starter（避免与 Boot 4 自动配置冲突）、不用 RLock（线程绑定与本系统跨线程续约/释放冲突）。 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
            <version>${clickhouse-jdbc.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 架构门禁（R6 信息模式）：仅 test scope，不新增运行期依赖；
             强制断言（违规 import = 0）待 straighten-event-factory-and-inbound 收尾时启用 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <!-- AgentScope 官方 PostgreSQL 扩展：AgentState 状态存储（agentscope.agentscope_sessions）与
             沙箱快照（agentscope_snapshots）持久化，扩展自动建表（createIfNotExist=true），不引入自研状态存储 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-postgresql</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <version>${json-path.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${org.apache.commons-lang3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <!-- JWT（HS256）签发与校验，无状态认证 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- bcrypt 密码散列（独立库，避免引入完整 Spring Security） -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>${bcrypt.version}</version>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${software.amazon.awssdk}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:"${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar" -Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                    <!-- 默认排除集成组；CI 集成任务以 -Dsurefire.excludedGroups= 置空显式放行 -->
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/com/linkroa/deepdataagent/DeepDataAgentApplication.class</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/*Application.class</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/config/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/configuration/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/dto/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/vo/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/entity/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/model/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/constant/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/enums/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/exception/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/*Test.class</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/*Tests.class</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/*Mock*</exclude>
                                <exclude>**/generated/**</exclude>
                                <exclude>**/*_*</exclude>
                                <!-- 需要集成测试的层，排除在单元测试覆盖率之外 -->
                                <exclude>**/com/linkroa/deepdataagent/**/controller/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/application/service/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/domain/service/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/infrastructure/client/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/infrastructure/adapter/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/sandbox/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/infrastructure/sse/**</exclude>
                                <!-- 声明式/生成式/数据库集成层（无单测价值，依赖集成测试验证）：
                                     MyBatis-Plus Mapper 接口、MapStruct 持久化映射器、Jdbc 仓储 -->
                                <exclude>**/com/linkroa/deepdataagent/**/persistence/mapper/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/agent/**/infrastructure/persistence/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/agent/**/infrastructure/repository/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/datasource/**/infrastructure/repository/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/knowledgebase/**/infrastructure/persistence/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/knowledgebase/**/infrastructure/repository/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/rag/**/infrastructure/persistence/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/rag/**/infrastructure/repository/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <exclude>**/com/linkroa/deepdataagent/DeepDataAgentApplication.class</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/*Application.class</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/config/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/configuration/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/dto/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/vo/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/entity/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/model/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/constant/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/enums/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/exception/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/*Test.class</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/*Tests.class</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/*Mock*</exclude>
                                <exclude>**/generated/**</exclude>
                                <exclude>**/*_*</exclude>
                                <!-- 需要集成测试的层，排除在单元测试覆盖率之外 -->
                                <exclude>**/com/linkroa/deepdataagent/**/controller/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/application/service/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/domain/service/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/infrastructure/client/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/infrastructure/adapter/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/sandbox/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/**/infrastructure/sse/**</exclude>
                                <!-- 声明式/生成式/数据库集成层（无单测价值，依赖集成测试验证）：
                                     MyBatis-Plus Mapper 接口、MapStruct 持久化映射器、Jdbc 仓储 -->
                                <exclude>**/com/linkroa/deepdataagent/**/persistence/mapper/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/agent/**/infrastructure/persistence/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/agent/**/infrastructure/repository/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/datasource/**/infrastructure/repository/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/knowledgebase/**/infrastructure/persistence/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/knowledgebase/**/infrastructure/repository/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/rag/**/infrastructure/persistence/**</exclude>
                                <exclude>**/com/linkroa/deepdataagent/rag/**/infrastructure/repository/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
