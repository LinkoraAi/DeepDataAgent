<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linkroa.deepdataagent.agent.infrastructure.persistence.mapper.LlmModelTemplateMapper">

    <select id="selectEnabledTemplates" resultType="com.linkroa.deepdataagent.agent.infrastructure.persistence.entity.LlmModelTemplateEntity">
        SELECT *
        FROM llm_model_template
        WHERE is_enabled = 1
        ORDER BY sort_order ASC
    </select>

    <select id="selectById" resultType="com.linkroa.deepdataagent.agent.infrastructure.persistence.entity.LlmModelTemplateEntity">
        SELECT *
        FROM llm_model_template
        WHERE id = #{id}
        LIMIT 1
    </select>

</mapper>
